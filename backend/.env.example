# Copy to .env and fill in real values. Never commit .env.

# Which provider generates embeddings: gemini | local
EMBEDDING_PROVIDER=gemini

# Which provider generates answers: gemini | groq | local
GENERATION_PROVIDER=gemini

# Required if either provider above is "gemini"
GEMINI_API_KEY=

# Required if GENERATION_PROVIDER=groq
GROQ_API_KEY=

# Only used when a provider is "local" (Ollama must be running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.1:8b

# SQLite file path
DATABASE_PATH=./knowledge_inbox.db

# Chunking
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=100

# Retrieval
TOP_K=4

# CORS - comma separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173
